<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clip_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/clip_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <ImageView
        android:id="@+id/clip_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_play"
        android:tint="@color/primary"
        android:background="@drawable/bg_record" />

    <ImageView
        android:id="@+id/clip_share"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:layout_marginLeft="8dp"
        android:src="@drawable/ic_share"
        android:tint="@color/text_dim"
        android:background="@drawable/bg_record" />

    <ImageView
        android:id="@+id/clip_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:layout_marginLeft="8dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/danger"
        android:background="@drawable/bg_record" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/header_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="male / female voice changer"
            android:textSize="11sp"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/view_studio" />
        <include layout="@layout/view_live" />
        <include layout="@layout/view_game" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/card_bg">

        <TextView
            android:id="@+id/tab_studio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_mic"
            android:drawablePadding="2dp"
            android:paddingTop="8dp"
            android:text="@string/tab_studio"
            android:textSize="11sp"
            android:textColor="@color/primary" />

        <TextView
            android:id="@+id/tab_live"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_live"
            android:drawablePadding="2dp"
            android:paddingTop="8dp"
            android:text="@string/tab_live"
            android:textSize="11sp"
            android:textColor="@color/tab_idle" />

        <TextView
            android:id="@+id/tab_game"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_game"
            android:drawablePadding="2dp"
            android:paddingTop="8dp"
            android:text="@string/tab_game"
            android:textSize="11sp"
            android:textColor="@color/tab_idle" />
    </LinearLayout>
</LinearLayout>

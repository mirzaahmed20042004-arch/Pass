<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/hud_bubble"
        android:layout_width="58dp"
        android:layout_height="58dp">

        <ImageView
            android:id="@+id/hud_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hud_panel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="66dp"
        android:background="@drawable/bg_panel"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOICE FILTER HUD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:textColor="@color/violet" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/hud_male"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:text="@string/mode_male"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/hud_female"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/mode_female"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/hud_monitor"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            style="@style/GhostButton"
            android:text="@string/hud_monitor_off" />

        <TextView
            android:id="@+id/hud_broadcast"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            style="@style/ActionButton"
            android:text="@string/hud_broadcast" />

        <TextView
            android:id="@+id/hud_hide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="@string/hud_hide"
            android:textSize="11sp"
            android:textColor="@color/text_dim" />
    </LinearLayout>
</FrameLayout>

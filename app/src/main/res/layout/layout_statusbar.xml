<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp">

    <TextView
        android:id="@+id/sb_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="26dp"
        android:text="9:41"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/sb_island"
        android:layout_width="110dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_island">

        <TextView
            android:id="@+id/sb_island_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_sb_signal" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_sb_wifi" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_sb_battery_frame" />

            <View
                android:id="@+id/sb_battery_fill"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginStart="2.5dp"
                android:layout_marginTop="3dp"
                android:background="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
